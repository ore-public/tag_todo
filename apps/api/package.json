{
  "name": "@tag-todo/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:types": "tsx scripts/generateDbTypes.ts",
    "db:types:check": "tsx scripts/generateDbTypes.ts --check",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e:serve": "pnpm db:migrate && tsx src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "~4.1.11",
    "jose": "^6.2.12",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "~4.1.11"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1140.0",
    "@aws-sdk/client-secrets-manager": "^3.1140.0",
    "@aws-sdk/credential-providers": "^3.1140.0",
    "@aws-sdk/dsql-signer": "^3.1140.0",
    "@aws/aurora-dsql-node-postgres-connector": "^0.1.9",
    "@hono/node-server": "^2.1.1",
    "@hono/oidc-auth": "^1.10.0",
    "@hono/zod-validator": "^0.9.1",
    "@tag-todo/shared": "workspace:*",
    "hono": "^4.13.8",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
