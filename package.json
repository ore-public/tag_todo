{
  "name": "tag-todo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tag-todo/worker --filter @tag-todo/web dev",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "depcruise": "depcruise apps packages",
    "dup": "jscpd",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm depcruise && pnpm dup && pnpm --filter @tag-todo/worker types:check",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "e2e": "playwright test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.1",
    "globals": "^17.12.0",
    "jscpd": "^5.3.2",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
